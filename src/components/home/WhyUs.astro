---
// ═══════════════════════════════════ WHY US — Sticky intro + numbered pillars
const pillars = [
  {
    num: "01",
    tag: "Strategy",
    title: "Expert-Led Marketing Strategies",
    desc: "Leverage deep clinical and industry insight to precisely target audiences, optimise campaigns, and achieve lasting brand growth.",
    icon: `<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>`,
  },
  {
    num: "02",
    tag: "Branding",
    title: "Targeted Brand Communication",
    desc: "Deliver personalised messages that resonate deeply — enhancing loyalty and strengthening brand identity across every touchpoint.",
    icon: `<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>`,
  },
  {
    num: "03",
    tag: "Partnership",
    title: "Collaborative Approach",
    desc: "We unite diverse perspectives and work as true partners — fostering innovation and driving outcomes neither side could achieve alone.",
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>`,
  },
  {
    num: "04",
    tag: "Innovation",
    title: "Cutting-Edge Innovation",
    desc: "We push boundaries by integrating emerging technologies and creative solutions to solve complex healthcare marketing challenges.",
    icon: `<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>`,
  },
];
---

<section id="testimonial" class="relative bg-white overflow-hidden">
  <!-- Top gradient divider -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent pointer-events-none"></div>

  <div class="max-w-screen-xl mx-auto px-6 lg:px-8 py-28 lg:py-40">
    <div class="grid lg:grid-cols-[0.8fr_1.2fr] gap-16 lg:gap-24">

      <!-- ── LEFT: sticky intro ── -->
      <div class="lg:sticky lg:top-28 lg:self-start">
        <div class="why-reveal flex items-center gap-4 mb-8">
          <span class="h-px w-10 bg-primary-500"></span>
          <p class="font-helvetica text-[0.65rem] font-bold tracking-[0.5em] text-primary-600 uppercase">
            Why Partner With Us
          </p>
        </div>

        <h2 class="why-reveal font-helvetica text-3xl sm:text-4xl lg:text-[3.1rem] font-bold text-slate-900 leading-[1.15] sm:leading-[1.1] tracking-tight mb-8">
          At Dr. Nathan <br class="hidden sm:block" />Marketing &amp; Consultancy
        </h2>

        <p class="why-reveal font-roboto text-sm lg:text-base text-slate-500 leading-relaxed max-w-md mb-10">
          We specialize in innovative and creative marketing strategies tailored specifically for the healthcare industry. Our team includes experienced doctors who combine medical expertise with marketing acumen, offering a unique advantage. Here are four key benefits of partnering with us.
        </p>

        <div class="why-rule h-px w-0 mb-10 bg-gradient-to-r from-primary-600 via-primary-300 to-transparent rounded-full"></div>

        <button
          id="testimonial_contact_us_btn"
          class="why-reveal group inline-flex items-center gap-4 cursor-pointer"
        >
          <span class="font-helvetica text-sm font-bold tracking-[0.12em] text-slate-900 group-hover:text-primary-700 transition-colors duration-300 uppercase">
            Start a Conversation
          </span>
          <span class="flex items-center justify-center w-11 h-11 rounded-full border border-slate-200 group-hover:border-primary-400 group-hover:bg-primary-50 transition-all duration-300">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600 transition-transform duration-300 group-hover:translate-x-0.5">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </span>
        </button>
      </div>

      <!-- ── RIGHT: numbered pillar rows ── -->
      <div class="flex flex-col">
        {pillars.map((p) => (
          <article class="why-row group relative grid grid-cols-[auto_1fr] gap-5 lg:gap-10 py-9 lg:py-12 border-t border-slate-100 last:border-b transition-colors duration-500 hover:bg-slate-50/60">
            <!-- Left hover accent -->
            <span class="absolute left-0 top-0 h-full w-[3px] origin-top scale-y-0 bg-gradient-to-b from-primary-600 to-primary-300 transition-transform duration-500 ease-out group-hover:scale-y-100"></span>

            <!-- Index -->
            <div class="pt-1 pl-1 lg:pl-3">
              <span class="font-helvetica text-4xl lg:text-6xl font-bold text-slate-200 tabular-nums leading-none transition-colors duration-500 group-hover:text-primary-600">
                {p.num}
              </span>
            </div>

            <!-- Body -->
            <div class="pr-1 lg:pr-4">
              <div class="flex items-center gap-4 mb-4">
                <div class="w-11 h-11 rounded-xl bg-slate-50 text-slate-400 flex items-center justify-center transition-all duration-500 group-hover:bg-primary-600 group-hover:text-white">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <Fragment set:html={p.icon} />
                  </svg>
                </div>
                <span class="font-helvetica text-[0.6rem] font-bold tracking-[0.35em] uppercase text-slate-300 transition-colors duration-500 group-hover:text-primary-500">
                  {p.tag}
                </span>
              </div>
              <h3 class="font-helvetica text-xl lg:text-2xl xl:text-[1.7rem] font-bold text-slate-800 leading-tight mb-3 transition-colors duration-300 group-hover:text-slate-900">
                {p.title}
              </h3>
              <p class="font-roboto text-sm lg:text-[0.95rem] text-slate-500 leading-relaxed max-w-xl">
                {p.desc}
              </p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>

  <!-- Bottom gradient divider -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-3/4 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent pointer-events-none"></div>
</section>

<script>
  import { revealOnScroll, gsap } from "src/utils/animations";
  import scrollToElement from "src/utils/scrollToElement";

  // CTA
  const btn = document.getElementById("testimonial_contact_us_btn");
  if (btn) btn.addEventListener("click", () => scrollToElement("contact_us"));

  // Intro reveals
  revealOnScroll(".why-reveal", { y: 20, stagger: 0.12 });

  const rule = document.querySelector<HTMLElement>(".why-rule");
  if (rule) {
    gsap.to(rule, {
      width: "100%",
      duration: 1.1,
      ease: "power2.inOut",
      scrollTrigger: { trigger: rule, start: "top 90%", once: true },
    });
  }

  // Pillar rows stagger in
  revealOnScroll(".why-row", { y: 44, stagger: 0.13, duration: 0.9 });
</script>
