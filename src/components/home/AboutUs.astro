---
// ═══════════════════════════════════ ABOUT US — Studio Manifesto + Live Metrics
const stats = [
  { end: "3.5", decimals: "1", suffix: "K+", label: "Creative Contents" },
  { end: "80", decimals: "0", suffix: "+", label: "Campaigns Delivered" },
  { end: "5", decimals: "0", suffix: "M+", label: "Audience Engagements" },
];
---

<section id="about_us" class="relative overflow-hidden bg-white">
  <!-- Faint ambient glow — echoes the hero -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-[10%] right-[-8%] w-[45%] h-[55%] rounded-full bg-primary-50/50 blur-[130px]"></div>
  </div>

  <div class="relative max-w-screen-xl mx-auto px-6 lg:px-8 py-28 lg:py-44">

    <!-- Eyebrow -->
    <div class="about-reveal flex items-center gap-4 mb-10 lg:mb-14">
      <span class="h-px w-10 bg-primary-500"></span>
      <p class="font-helvetica text-[0.65rem] font-bold tracking-[0.5em] text-primary-600 uppercase">
        Who We Are
      </p>
    </div>

    <!-- Big manifesto statement (kinetic word reveal) -->
    <div class="max-w-5xl">
      <p class="about-reveal font-roboto text-sm text-slate-400 tracking-wide mb-6">We are a —</p>
      <h2
        class="about-statement font-helvetica font-bold text-slate-900 tracking-tight leading-[1.15] sm:leading-[1.12] text-2xl sm:text-3xl md:text-4xl lg:text-[3.4rem]"
      >
        Startup founded by a group of doctors, delivering premium, insight-led marketing built exclusively for the healthcare industry in Myanmar.
      </h2>
    </div>

    <!-- Animated rule -->
    <div class="about-rule h-px w-0 mt-16 lg:mt-24 bg-gradient-to-r from-primary-600 via-primary-300 to-transparent rounded-full"></div>

    <!-- Metrics -->
    <div class="grid grid-cols-1 sm:grid-cols-3 mt-14 lg:mt-16 border-t border-slate-100">
      {stats.map((s) => (
        <div class="about-stat py-10 sm:py-12 sm:px-8 first:sm:pl-0 border-b sm:border-b-0 sm:border-r last:border-r-0 border-slate-100">
          <p class="flex items-baseline">
            <span
              class="font-helvetica text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold text-primary-900 tabular-nums leading-none"
              data-count-end={s.end}
              data-count-decimals={s.decimals}
              data-count-suffix={s.suffix}
            >0{s.suffix}</span>
          </p>
          <p class="mt-5 font-roboto text-sm text-slate-500 tracking-wide">{s.label}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  import { revealOnScroll, revealHeading, initCounters, gsap } from "src/utils/animations";

  // Eyebrow + lead line + rule
  revealOnScroll(".about-reveal", { y: 20, stagger: 0.12 });

  // Kinetic manifesto heading
  revealHeading(document.querySelector<HTMLElement>(".about-statement"), {
    stagger: 0.04,
    duration: 0.9,
  });

  // Animated rule sweeps to full width when it scrolls in
  const rule = document.querySelector<HTMLElement>(".about-rule");
  if (rule) {
    gsap.to(rule, {
      width: "100%",
      duration: 1.2,
      ease: "power2.inOut",
      scrollTrigger: { trigger: rule, start: "top 88%", once: true },
    });
  }

  // Stat blocks rise in, numbers count up
  revealOnScroll(".about-stat", { y: 32, stagger: 0.14, duration: 1 });
  initCounters();
</script>
