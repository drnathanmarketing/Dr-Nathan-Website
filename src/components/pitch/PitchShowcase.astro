---
// ═══════════════════════════ PITCH SHOWCASE — pinned horizontal work gallery
// The signature moment of the pitch. Mirrors the proven Service.astro
// architecture (gsap.matchMedia, .is-horizontal toggle, containerAnimation
// reveals) with an added image-grid parallax scrubbed by the same tween.
// Mobile / reduced-motion: panels stack vertically with simple reveals.
interface Panel {
  num: string;
  tag: string;
  title: string;
  desc: string;
  images?: string[];
  chips?: string[];
}

const panels: Panel[] = [
  {
    num: "01",
    tag: "The Work",
    title: "4,500+ pieces of work.",
    desc: "Six years in market, distilled into a four-stop tour of what we ship — from doctor-written content to full-scale events.",
  },
  {
    num: "02",
    tag: "Content",
    title: "Content made by doctors",
    desc: "Health articles, catalogs of 6–10 slides, quizzes, motion slides, and medical translation — accuracy and empathy in the same asset.",
    images: ["cm1", "cm2", "cm5", "cm6"],
    chips: ["Health articles", "Catalog design", "Quizzes", "Motion slides", "Medical translation"],
  },
  {
    num: "03",
    tag: "Production",
    title: "Motion & production",
    desc: "Motion graphics of 10–20 seconds, product photography, packaging and print — cinematic polish, clinical precision.",
    images: ["vppp1", "vppp2", "vppp3", "vppp4"],
    chips: ["Motion graphics", "Product photography", "Packaging & printing"],
  },
  {
    num: "04",
    tag: "Events",
    title: "Events, webinars & CMEs",
    desc: "From Yangon to cities nationwide — conferences, webinars, and CMEs planned, produced, and staffed end to end.",
    images: ["ep1", "ep2", "ep3", "ep4"],
    chips: ["Event planning", "Webinars & CMEs", "Market surveys"],
  },
  {
    num: "05",
    tag: "People",
    title: "Doctors & KOLs on camera",
    desc: "Doctor-run Q&A comment care, KOL discussion videos, personal branding, and Viber channel management — real experts, earning real trust.",
    images: ["tm1", "tm2", "tm3", "tm4"],
    chips: ["Doctor-run Q&A", "KOL videos", "Personal branding", "Viber channels"],
  },
];
---

<section id="pitch-showcase" class="relative bg-primary-950 text-white overflow-hidden">

  <!-- ── Pinned horizontal track ── -->
  <div class="pitch-pin-wrap relative">
    <div class="pitch-track">
      {panels.map((p) => (
        <section class="pitch-panel relative">
          <div class="h-full w-full flex items-center py-20 lg:py-0">
            <div class={`w-full max-w-screen-2xl mx-auto px-6 sm:px-10 lg:px-16 ${p.images ? "grid lg:grid-cols-2 gap-12 lg:gap-16 items-center" : ""}`}>

              <!-- Text -->
              <div class="panel-text relative order-1">
                <span class="absolute -top-6 -left-1 lg:-top-20 lg:-left-6 font-helvetica font-bold leading-none pointer-events-none select-none text-[4.5rem] sm:text-[7rem] lg:text-[15rem] text-white/[0.05]">{p.num}</span>
                <div class="relative z-10">
                  <div class="panel-anim flex items-center gap-4 mb-6">
                    <span class="h-px w-10 bg-primary-400"></span>
                    <span class="font-helvetica text-[0.65rem] font-bold tracking-[0.4em] uppercase text-primary-300">{p.tag}</span>
                  </div>
                  <h3 class={`panel-anim font-helvetica font-bold text-white leading-[1.15] sm:leading-[1.1] mb-6 ${p.images ? "text-2xl sm:text-3xl md:text-4xl lg:text-5xl" : "text-3xl sm:text-5xl md:text-6xl lg:text-7xl"}`}>
                    {p.title}
                  </h3>
                  <p class={`panel-anim font-roboto text-sm lg:text-base text-white/60 leading-relaxed ${p.images ? "max-w-md" : "max-w-xl"}`}>
                    {p.desc}
                  </p>
                  {p.chips && (
                    <div class="panel-anim mt-7 flex flex-wrap gap-2 max-w-md">
                      {p.chips.map((chip) => (
                        <span class="font-helvetica text-[0.6rem] lg:text-[0.65rem] font-bold tracking-[0.18em] uppercase text-white/70 border border-white/15 rounded-full px-3.5 py-1.5">
                          {chip}
                        </span>
                      ))}
                    </div>
                  )}
                  {!p.images && (
                    <div class="panel-anim mt-10 hidden lg:flex items-center gap-3 text-white/40">
                      <span class="text-xs tracking-[0.3em] uppercase font-bold font-helvetica">Scroll to explore</span>
                      <svg width="34" height="14" viewBox="0 0 34 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M0 7h32M27 2l5 5-5 5" />
                      </svg>
                    </div>
                  )}
                </div>
              </div>

              <!-- Image grid -->
              {p.images && (
                <div class="order-2">
                  <div class="panel-media w-full max-w-[440px] lg:max-w-[540px] mx-auto">
                    <div class="panel-media-inner grid grid-cols-2 gap-2 lg:gap-3">
                      {p.images.map((img, i) => (
                        <img
                          src={`/assets/services/${img}.jpg`}
                          alt={`${p.title} — ${p.tag} ${i + 1}`}
                          loading="lazy"
                          decoding="async"
                          class="w-full aspect-square object-cover"
                        />
                      ))}
                    </div>
                  </div>
                </div>
              )}

            </div>
          </div>
        </section>
      ))}
    </div>

    <!-- Progress UI (visible only in horizontal mode) -->
    <div class="pitch-progress absolute bottom-0 left-0 w-full px-6 lg:px-16 pb-8 pointer-events-none z-30">
      <div class="max-w-screen-2xl mx-auto flex items-center gap-6">
        <span class="pitch-counter font-helvetica text-white font-bold text-lg tabular-nums">01</span>
        <div class="flex-1 h-px bg-white/15 relative overflow-hidden">
          <span class="pitch-progress-bar absolute inset-0 origin-left bg-primary-400" style="transform: scaleX(0)"></span>
        </div>
        <span class="font-helvetica text-white/40 font-bold text-lg tabular-nums">05</span>
      </div>
    </div>
  </div>

</section>

<style>
  /* Default (mobile / reduced-motion): panels stack vertically */
  .pitch-track { display: flex; flex-direction: column; }
  .pitch-panel { width: 100%; }

  /* Horizontal mode is toggled by JS only on capable desktops */
  .pitch-track.is-horizontal {
    flex-direction: row;
    flex-wrap: nowrap;
    height: 100vh;
    width: max-content;
  }
  .pitch-track.is-horizontal .pitch-panel {
    width: 100vw;
    height: 100vh;
    flex-shrink: 0;
  }
  .pitch-pin-wrap.is-horizontal { overflow: hidden; }

  .pitch-progress { opacity: 0; transition: opacity 0.4s ease; }
  .pitch-pin-wrap.is-horizontal .pitch-progress { opacity: 1; }
</style>

<script>
  import { gsap, revealOnScroll } from "src/utils/animations";

  const section = document.getElementById("pitch-showcase");
  const pinWrap = section?.querySelector<HTMLElement>(".pitch-pin-wrap");
  const track = section?.querySelector<HTMLElement>(".pitch-track");
  const counterEl = section?.querySelector<HTMLElement>(".pitch-counter");
  const progressBar = section?.querySelector<HTMLElement>(".pitch-progress-bar");
  const panels = gsap.utils.toArray<HTMLElement>(".pitch-panel");

  if (pinWrap && track && panels.length) {
    const mm = gsap.matchMedia();

    // ── Desktop + motion: pinned horizontal scroll ──
    mm.add("(min-width: 1024px) and (prefers-reduced-motion: no-preference)", () => {
      pinWrap.classList.add("is-horizontal");
      track.classList.add("is-horizontal");

      const getDistance = () => track.scrollWidth - window.innerWidth;

      const tween = gsap.to(track, {
        x: () => -getDistance(),
        ease: "none",
        scrollTrigger: {
          trigger: pinWrap,
          start: "top top",
          end: () => "+=" + getDistance(),
          pin: true,
          scrub: 1,
          anticipatePin: 1,
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            const n = panels.length;
            const idx = Math.min(n - 1, Math.round(self.progress * (n - 1)));
            if (counterEl) counterEl.textContent = String(idx + 1).padStart(2, "0");
            if (progressBar) progressBar.style.transform = `scaleX(${self.progress})`;
          },
        },
      });

      // Per-panel reveals driven by the horizontal scroll
      panels.forEach((panel) => {
        gsap.fromTo(
          panel.querySelectorAll<HTMLElement>(".panel-anim"),
          { y: 44, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.6,
            stagger: 0.09,
            ease: "power3.out",
            scrollTrigger: { trigger: panel, containerAnimation: tween, start: "left 78%", toggleActions: "play none none reverse" },
          }
        );

        const media = panel.querySelector<HTMLElement>(".panel-media");
        if (media) {
          gsap.fromTo(
            media,
            { y: 40, opacity: 0, scale: 0.97 },
            {
              y: 0,
              opacity: 1,
              scale: 1,
              duration: 0.7,
              ease: "power3.out",
              scrollTrigger: { trigger: panel, containerAnimation: tween, start: "left 80%", toggleActions: "play none none reverse" },
            }
          );

          // Gallery parallax: the grid drifts against the track direction
          const inner = media.querySelector<HTMLElement>(".panel-media-inner");
          if (inner) {
            gsap.fromTo(
              inner,
              { xPercent: 5 },
              {
                xPercent: -5,
                ease: "none",
                scrollTrigger: {
                  trigger: panel,
                  containerAnimation: tween,
                  start: "left right",
                  end: "right left",
                  scrub: true,
                },
              }
            );
          }
        }
      });

      return () => {
        pinWrap.classList.remove("is-horizontal");
        track.classList.remove("is-horizontal");
        gsap.set(track, { clearProps: "transform" });
        panels.forEach((panel) => {
          gsap.set(panel.querySelectorAll<HTMLElement>(".panel-anim, .panel-media, .panel-media-inner"), { clearProps: "all" });
        });
      };
    });

    // ── Mobile / reduced-motion: simple stacked reveals ──
    mm.add("(max-width: 1023px), (prefers-reduced-motion: reduce)", () => {
      panels.forEach((panel) => {
        revealOnScroll(panel.querySelectorAll<HTMLElement>(".panel-anim, .panel-media"), { y: 30, stagger: 0.08 });
      });
    });
  }
</script>
