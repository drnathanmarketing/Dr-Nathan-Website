---
// ═══════════════════════════ CREDENTIALS — private, lead-gated pitch page
// Shared only by link inside proposals. Kept out of search engines via
// noindex meta (Layout) and X-Robots-Tag headers (vercel.json). Never link
// this page from the Navbar, Footer, or any other page.
//
// Server-rendered on purpose: without a valid signed access cookie we render
// ONLY the lead gate, so none of the pitch content is ever sent to the
// browser. Viewing source before submitting reveals nothing.
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import Footer from "@components/common/Footer.astro";
import PitchGate from "@components/pitch/PitchGate.astro";
import PitchHero from "@components/pitch/PitchHero.astro";
import PitchStory from "@components/pitch/PitchStory.astro";
import PitchProblem from "@components/pitch/PitchProblem.astro";
import PitchSegments from "@components/pitch/PitchSegments.astro";
import PitchShowcase from "@components/pitch/PitchShowcase.astro";
import PitchChannels from "@components/pitch/PitchChannels.astro";
import PitchNumbers from "@components/pitch/PitchNumbers.astro";
import PitchConsultancy from "@components/pitch/PitchConsultancy.astro";
import PitchCTA from "@components/pitch/PitchCTA.astro";
import PitchEffects from "@components/pitch/PitchEffects.astro";
import { GATE_COOKIE, verifyGateToken } from "src/utils/gateToken";

const unlocked = verifyGateToken(Astro.cookies.get(GATE_COOKIE)?.value);
---

<Layout
  title={unlocked
    ? "Agency Credentials | Dr. Nathan Marketing & Consultancy"
    : "Request Access | Dr. Nathan Marketing & Consultancy"}
  description="Doctor-founded marketing for healthcare and consumer brands in Myanmar — our story, our work, and the results behind it."
  noindex={true}
>
  {unlocked ? (
    <>
      <main>
        <PitchHero />
        <PitchStory />
        <PitchProblem />
        <PitchSegments />
        <PitchShowcase />
        <PitchChannels />
        <PitchNumbers />
        <PitchConsultancy />
        <PitchCTA />
      </main>
      <PitchEffects />
      <Footer />
    </>
  ) : (
    <>
      <main>
        <PitchGate />
      </main>
      <PitchEffects />
    </>
  )}
</Layout>
