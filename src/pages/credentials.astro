---
// ═══════════════════════════ CREDENTIALS — private pitch page
// Shared only by link inside proposals. Kept out of search engines via
// noindex meta (Layout), the sitemap filter (astro.config.mjs), and
// X-Robots-Tag headers (vercel.json). Never link this page from the
// Navbar, Footer, or any other page.
import Layout from "../layouts/Layout.astro";
import Footer from "@components/common/Footer.astro";
import PitchHero from "@components/pitch/PitchHero.astro";
import PitchStory from "@components/pitch/PitchStory.astro";
import PitchProblem from "@components/pitch/PitchProblem.astro";
import PitchSegments from "@components/pitch/PitchSegments.astro";
import PitchShowcase from "@components/pitch/PitchShowcase.astro";
import PitchChannels from "@components/pitch/PitchChannels.astro";
import PitchNumbers from "@components/pitch/PitchNumbers.astro";
import PitchConsultancy from "@components/pitch/PitchConsultancy.astro";
import PitchCTA from "@components/pitch/PitchCTA.astro";
import PitchEffects from "@components/pitch/PitchEffects.astro";
---

<Layout
  title="Agency Credentials | Dr. Nathan Marketing & Consultancy"
  description="Doctor-founded marketing for healthcare and consumer brands in Myanmar — our story, our work, and the results behind it."
  noindex={true}
>
  <main>
    <PitchHero />
    <PitchStory />
    <PitchProblem />
    <PitchSegments />
    <PitchShowcase />
    <PitchChannels />
    <PitchNumbers />
    <PitchConsultancy />
    <PitchCTA />
  </main>
  <PitchEffects />
  <Footer />
</Layout>
