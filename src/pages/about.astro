<style>
  /* ── Ticker ── */
  @keyframes ticker {
    from { transform: translateX(0); }
    to   { transform: translateX(-33.333%); }
  }
  .ticker-track {
    animation: ticker 30s linear infinite;
  }

  /* ── Cursor blink ── */
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }
  .hero-cursor {
    animation: blink 1.1s step-end infinite;
  }

  /* ── CTA button pulse ── */
  @keyframes border-pulse {
    0%, 100% { border-color: rgba(255,255,255,0.3); box-shadow: 0 0 0 0 rgba(255,255,255,0); }
    50%       { border-color: rgba(255,255,255,0.7); box-shadow: 0 0 20px 4px rgba(255,255,255,0.1); }
  }
  .cta-pulse-btn {
    animation: border-pulse 2.5s ease-in-out infinite;
  }
  .cta-pulse-btn:hover {
    animation: none;
  }

  /* ── Founder card lift ── */
  .founder-card {
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow 0.4s ease, border-color 0.4s ease;
  }
  .founder-card:hover {
    transform: translateY(-4px);
  }
</style>

<script>
  import gsap from "gsap";

  /* ── Hero: eyebrow + word-by-word reveal ── */
  const heroTl = gsap.timeline({ delay: 0.2 });
  heroTl
    .fromTo(".hero-eyebrow",
      { opacity: 0, x: -12 },
      { opacity: 1, x: 0, duration: 0.6, ease: "power3.out" }
    )
    .fromTo(".hero-word",
      { opacity: 0, y: 40, skewY: 3 },
      { opacity: 1, y: 0, skewY: 0, duration: 0.7, stagger: 0.08, ease: "power3.out" },
      "-=0.2"
    )
    .fromTo(".hero-sub",
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8, ease: "power2.out" },
      "-=0.3"
    )
    .fromTo(".hero-stat",
      { opacity: 0, y: 16 },
      { opacity: 1, y: 0, duration: 0.7, ease: "power2.out" },
      "-=0.5"
    );

  /* ── Pillar top-border sweep-in ── */
  const pillarSection = document.querySelector(".pillar-block")?.closest("section");
  if (pillarSection) {
    const pillarObs = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        gsap.to(".pillar-top-border", {
          width: "100%", duration: 1, stagger: 0.2, ease: "power2.inOut", delay: 0.4,
        });
        pillarObs.disconnect();
      });
    }, { threshold: 0.2 });
    pillarObs.observe(pillarSection);
  }

  /* ── Genesis scroll-progress line ── */
  const genesisLine = document.getElementById("genesis-line");
  const genesisSection = document.querySelector(".genesis-h2")?.closest("section");
  if (genesisLine && genesisSection) {
    window.addEventListener("scroll", () => {
      const rect = genesisSection.getBoundingClientRect();
      const progress = Math.max(0, Math.min(1, -rect.top / (rect.height - window.innerHeight)));
      (genesisLine as HTMLElement).style.height = (progress * 100) + "%";
    }, { passive: true });
  }

  /* ── Stat count-up ── */
  const statNums = document.querySelectorAll(".stat-num");
  const countObs = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      statNums.forEach((el) => {
        const target = parseInt(el.getAttribute("data-target") || "0", 10);
        const suffix = el.getAttribute("data-suffix") || "";
        const duration = 1800;
        const start = performance.now();
        const startVal = 0;
        const update = (now: number) => {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const current = Math.round(startVal + (target - startVal) * eased);
          el.textContent = current + suffix;
          if (progress < 1) requestAnimationFrame(update);
        };
        requestAnimationFrame(update);
      });
      countObs.disconnect();
    });
  }, { threshold: 0.4 });
  if (statNums[0]) countObs.observe(statNums[0]);

  /* ── Scroll-triggered section reveals ── */
  const revealGroups = [
    { selector: ".stat-block",                               threshold: 0.2 },
    { selector: ".genesis-eyebrow, .genesis-h2, .genesis-p", threshold: 0.2 },
    { selector: ".pillars-eyebrow, .pillar-block",           threshold: 0.15 },
    { selector: ".phil-eyebrow, .phil-h2, .phil-item",       threshold: 0.1 },
    { selector: ".founders-eyebrow, .founders-h2, .founder-card", threshold: 0.1 },
  ];

  revealGroups.forEach(({ selector, threshold }) => {
    const els = document.querySelectorAll(selector);
    if (!els.length) return;
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          gsap.fromTo(
            els,
            { opacity: 0, y: 28 },
            { opacity: 1, y: 0, duration: 0.85, stagger: 0.1, ease: "power3.out" }
          );
          obs.disconnect();
        });
      },
      { threshold }
    );
    obs.observe(els[0]);
  });
</script>
